# 真实模型运行所需配置（离线 Mock 模式 --mock 不需要任何变量）
# 复制为 .env 后填写；.env 已在 .gitignore 中，不会入库。

# API Key
OPENAI_API_KEY=

# OpenAI 兼容接口地址；留空表示使用 OpenAI 官方地址
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# 模型名，需支持 function calling，建议非推理模型
#   例如 gpt-4o-mini / deepseek-chat / qwen-plus
MODEL_NAME=

# 采样温度；留空则不传该参数（部分推理模型不接受 temperature）
LLM_TEMPERATURE=0
